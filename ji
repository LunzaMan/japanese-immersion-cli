    local commands; commands=(
'add:' \
'list:' \
'current:' \
'cards:' \
'episode:' \
'set-current:' \
'set-date:' \
'set-status:' \
'complete:' \
'export:' \
'delete:' \
'test:' \
'generate-completion:' \
'help:Print this message or the help of the given subcommand(s)' \
