#compdef ji-cli

autoload -U is-at-least

_ji-cli() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-v[]' \
'--verbose[]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_ji-cli_commands" \
"*::: :->ji-cli" \
&& ret=0
    case $state in
    (ji-cli)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:ji-cli-command-$line[1]:"
        case $line[1] in
            (add)
_arguments "${_arguments_options[@]}" : \
'-v[]' \
'--verbose[]' \
'-h[Print help]' \
'--help[Print help]' \
'::name:_default' \
&& ret=0
;;
(list)
_arguments "${_arguments_options[@]}" : \
'-v[]' \
'--verbose[]' \
'-h[Print help]' \
'--help[Print help]' \
'::status:(all watching planning completed)' \
&& ret=0
;;
(current)
_arguments "${_arguments_options[@]}" : \
'-v[]' \
'--verbose[]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(cards)
_arguments "${_arguments_options[@]}" : \
'--name=[]:NAME:_default' \
'-v[]' \
'--verbose[]' \
'-h[Print help]' \
'--help[Print help]' \
':card_command:(add total)' \
':number:_default' \
&& ret=0
;;
(episode)
_arguments "${_arguments_options[@]}" : \
'--name=[]:NAME:_default' \
'-v[]' \
'--verbose[]' \
'-h[Print help]' \
'--help[Print help]' \
":: :_ji-cli__subcmd__episode_commands" \
"*::: :->episode" \
&& ret=0

    case $state in
    (episode)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:ji-cli-episode-command-$line[1]:"
        case $line[1] in
            (add)
_arguments "${_arguments_options[@]}" : \
'--name=[]:NAME:_default' \
'-v[]' \
'--verbose[]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(subtract)
_arguments "${_arguments_options[@]}" : \
'--name=[]:NAME:_default' \
'-v[]' \
'--verbose[]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(set)
_arguments "${_arguments_options[@]}" : \
'--name=[]:NAME:_default' \
'-v[]' \
'--verbose[]' \
'-h[Print help]' \
'--help[Print help]' \
':number:_default' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_ji-cli__subcmd__episode__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:ji-cli-episode-help-command-$line[1]:"
        case $line[1] in
            (add)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(subtract)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(set)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
;;
(set-current)
_arguments "${_arguments_options[@]}" : \
'-v[]' \
'--verbose[]' \
'-h[Print help]' \
'--help[Print help]' \
':name:_default' \
&& ret=0
;;
(set-date)
_arguments "${_arguments_options[@]}" : \
'-v[]' \
'--verbose[]' \
'-h[Print help]' \
'--help[Print help]' \
':date_type:(start end)' \
':date:_default' \
':name:_default' \
&& ret=0
;;
(set-status)
_arguments "${_arguments_options[@]}" : \
'-v[]' \
'--verbose[]' \
'-h[Print help]' \
'--help[Print help]' \
':watch_status:(watching completed planning)' \
'::name:_default' \
&& ret=0
;;
(complete)
_arguments "${_arguments_options[@]}" : \
'--date=[]:DATE:_default' \
'-v[]' \
'--verbose[]' \
'-h[Print help]' \
'--help[Print help]' \
'::name:_default' \
&& ret=0
;;
(export)
_arguments "${_arguments_options[@]}" : \
'--path=[]:PATH:_files' \
'-v[]' \
'--verbose[]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(delete)
_arguments "${_arguments_options[@]}" : \
'-v[]' \
'--verbose[]' \
'-h[Print help]' \
'--help[Print help]' \
':name:_default' \
&& ret=0
;;
(test)
_arguments "${_arguments_options[@]}" : \
'-v[]' \
'--verbose[]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(generate-completion)
_arguments "${_arguments_options[@]}" : \
'-v[]' \
'--verbose[]' \
'-h[Print help]' \
'--help[Print help]' \
':shell:(bash elvish fish powershell zsh)' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_ji-cli__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:ji-cli-help-command-$line[1]:"
        case $line[1] in
            (add)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(list)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(current)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(cards)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(episode)
_arguments "${_arguments_options[@]}" : \
":: :_ji-cli__subcmd__help__subcmd__episode_commands" \
"*::: :->episode" \
&& ret=0

    case $state in
    (episode)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:ji-cli-help-episode-command-$line[1]:"
        case $line[1] in
            (add)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(subtract)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(set)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
(set-current)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(set-date)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(set-status)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(complete)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(export)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(delete)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(test)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(generate-completion)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_ji-cli_commands] )) ||
_ji-cli_commands() {
    local commands; commands=(
'add:search for anime in Anilist' \
'list:List anime' \
'current:get current anime' \
'cards:add number of anki cards for the anime' \
'episode:' \
'set-current:' \
'set-date:' \
'set-status:' \
'complete:' \
'export:' \
'delete:' \
'test:' \
'generate-completion:' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'ji-cli commands' commands "$@"
}
